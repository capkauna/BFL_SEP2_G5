<AnchorPane style="-fx-background-color: #990000;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="Client.view.UserListViewController">
    <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
        <HBox prefWidth="602.0" spacing="10">
            <Button onAction="#onBack" text="←" />
            <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="Users" />
        </HBox>
        <TableView fx:id="userTable">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="200" text="Name" />
                <TableColumn fx:id="libraryColumn" prefWidth="200" text="Books in library" />
                <TableColumn fx:id="readColumn" prefWidth="200" text="Books read" />
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
